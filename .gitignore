.data/
*.log

# noir / barretenberg build artifacts (regenerated by `pnpm circuits:build`)
circuits/**/target/

# foundry
cache/
broadcast/

# editors / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# firmware: PlatformIO build output, and the headers the syntax check downloads
.pio/
firmware/**/check/.deps/

# Pinky Promise — configuration for the real networks (`pnpm gateway`, `pnpm demo --live`).
#
#   cp .env.example .env      then fill in the values and run `pnpm doctor`
#
# The local demo (`pnpm demo`) needs none of this. Never commit .env: it holds private keys.
# A private key is 0x followed by 64 hex characters. `cast wallet new` (Foundry) makes one.
# ENV_FILE=<path> reads another file instead (`pnpm devnets` writes .env.rehearsal that way).

# --- gateway -------------------------------------------------------------------------------
PORT=8787
HOST=127.0.0.1
DATA_DIR=.data/gateway
# Protects the operator API (venues, devices, lots, release). At least 16 characters.
ADMIN_TOKEN=
# true = let visitors onboard their own wallet and fetch view keys (demos only).
GATEWAY_DEMO=false
# false = skip the ZK geofence proofs (the plan's last scope cut).
GEOFENCE_PROOFS=true

# Signs lot profiles and writes Device / Venue / Lot entities on Arkiv. Needs Arkiv gas.
REGISTRY_KEY=
# Writes GeoProof entities on Arkiv. Needs Arkiv gas.
GATEWAY_KEY=
# Signs the decision attestations the Hedera oracle checks. Needs no funds.
ATTESTOR_KEY=

# --- Arkiv (Rabdi testnet by default) --------------------------------------------------------
# Access key from https://hub.arkiv.network/access-keys (empty = public, rate-limited endpoint).
ARKIV_ACCESS_KEY=
# The endpoint the buyer page is told to use. Defaults to the public Rabdi endpoint, so the
# access key above is never sent to browsers.
ARKIV_PUBLIC_RPC_URL=
# Only for a custom or local node:
ARKIV_RPC_URL=
ARKIV_CHAIN_ID=
ARKIV_EXPLORER_URL=

# --- Hedera (testnet by default) -------------------------------------------------------------
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_CHAIN_ID=296
HEDERA_EXPLORER_URL=https://hashscan.io/testnet
# Asset Tokenization Studio on testnet (defaults are the published v8 deployment).
HEDERA_ATS_FACTORY=
HEDERA_ATS_RESOLVER=
# Printed by `pnpm deploy:hedera`.
HEDERA_ORACLE=
HEDERA_MARKET=
# Three ECDSA accounts with test HBAR (https://portal.hedera.com/faucet):
# deploys each lot's token and is its admin / KYC issuer
HEDERA_ISSUER_KEY=
# submits checkpoints to the oracle (pays the gas, holds no rights)
HEDERA_RELAYER_KEY=
# the only account that can release a frozen lot
HEDERA_INSPECTOR_KEY=

# --- 0G ----------------------------------------------------------------------------------------
# router = the real 0G Compute Router. mock = the local stand-in, for rehearsals only: its
# decisions are recorded as dev-mock and never presented as 0G.
ZG_MODE=router
# Compute Router (OpenAI-compatible). Check the current URL in the 0G docs.
ZG_ROUTER_URL=https://router-api.0g.ai/v1
ZG_API_KEY=
# Must accept image input, e.g. qwen2.5-vl-72b-instruct. `pnpm doctor` lists the models that do.
ZG_MODEL=
# true = ask the Router to verify the provider's TEE signature before answering.
ZG_VERIFY_TEE=false
# 0g = encrypted episode logs go to 0G Storage. local = they stay in DATA_DIR (no storage funds yet).
ZG_STORAGE=0g
# Storage for the encrypted episode logs. The key pays the storage fee in 0G.
ZG_STORAGE_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_STORAGE_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
ZG_STORAGE_KEY=
ZG_STORAGE_EXPLORER_URL=

# --- pnpm demo --live ----------------------------------------------------------------------------
# Who receives the units when custody is accepted and offers 40 on the market. Needs a little
# HBAR for gas. Empty = the issuer account.
DEMO_DEPOSITOR_KEY=
# A wallet to allow-list for buying from the buyer page (your MetaMask address). Optional.
DEMO_BUYER_ADDRESS=
